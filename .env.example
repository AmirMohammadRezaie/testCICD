# Copy this file to .env for local development and fill in your own values.
# .env is ignored by Git. Never commit real values.

# Secret API key for your OpenAI-compatible AI provider (server-side only)
CHAT_API_KEY=your-api-key-here

# Base URL of the API; the server calls {CHAT_API_BASE_URL}/chat/completions
CHAT_API_BASE_URL=https://api.example.com/v1

# Model identifier offered by your provider
CHAT_MODEL=your-model-name

# Optional settings
# PORT=3000
# CHAT_TIMEOUT_MS=20000
# Set to true when hosted behind a reverse proxy/load balancer (most hosting platforms)
# so rate limiting sees each visitor's real IP address.
# TRUST_PROXY=true
